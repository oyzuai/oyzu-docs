{
  "extraKnownMarketplaces": {
    "oyzu-context": {
      "source": {
        "source": "github",
        "repo": "oyzuai/context"
      },
      "autoUpdate": true
    }
  },
  "enabledPlugins": {
    "context@oyzu-context": true,
    "ponytail@oyzu-context": true,
    "pstack@oyzu-context": true,
    "thermonuclear@oyzu-context": true
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/hook-runner.mjs\" session-start claude || exit 2",
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/hook-runner.mjs\" pre-tool-use claude || exit 2",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
